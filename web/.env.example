# The Fly worker that serves /latest.json and /history.json
WORKER_URL=https://vol-surface-live.fly.dev
# Optional bearer token, if the worker sets LATEST_TOKEN
LATEST_TOKEN=
# Public Vercel Blob base URL for the daily archive (or a local directory in development)
BLOB_BASE_URL=https://<store-id>.public.blob.vercel-storage.com
NEXT_PUBLIC_SITE_URL=https://vol.iliaduda.com
